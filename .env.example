# 今日 AI 盲盒 - 资讯 API（任选其一，配置后优先使用）
# GNews: https://gnews.io/ （免费约 100 次/天，推荐）
GNEWS_API_KEY=

# NewsAPI: https://newsapi.org/ （免费约 100 次/天，国内需代理）
NEWS_API_KEY=

# 联系页 AI 问答助手 - DeepSeek（OpenAI 兼容接口）
# 复制本文件为 .env.local 后填写，切勿提交 .env.local 到 Git
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# AI 问答助手 - 对话记录查看密码（访问 /admin/chat-logs）
ADMIN_PASSWORD=

# Vercel 部署：在项目 Storage 中创建 Blob 并 Connect to Project 后，会自动注入：
# BLOB_READ_WRITE_TOKEN（或 OIDC 模式下的 BLOB_STORE_ID + VERCEL_OIDC_TOKEN）
# 本地开发可不填，记录会写入 data/chat-logs/conversations.jsonl
BLOB_READ_WRITE_TOKEN=
